---
// Community.astro
const testimonials = [
  {
    name: "Thu Hương",
    role: "Kinh doanh tự do",
    avatar: "👩‍💼",
    quote: "Trước giờ tôi chỉ biết dùng Word với Excel cơ bản. Sau khi xem chuỗi video Vibe Coding của anh Việt, tôi đã tự tạo được trang web đặt hàng và quản lý đơn cho tiệm trà hoa của mình chỉ sau đúng 4 ngày!",
    highlight: "Tự tạo web đặt hàng sau 4 ngày"
  },
  {
    name: "Anh Hoàng Minh",
    role: "Chuyên viên Marketing",
    avatar: "👨‍💻",
    quote: "AI Agent đã hoàn toàn giải phóng tôi khỏi đống việc lặp lại nhàm chán. Tôi áp dụng n8n và Gemini để tự động quét tin tức thị trường, tổng hợp báo cáo gửi email vào mỗi 7h sáng.",
    highlight: "Tiết kiệm 3 giờ làm việc mỗi ngày"
  },
  {
    name: "Đức Linh",
    role: "Sinh viên năm 3",
    avatar: "🧑‍🎓",
    quote: "Không cần phải học 4 năm đại học IT mới làm được sản phẩm. Tư duy Vibe Coding giúp em hiện thực hóa các ý tưởng đồ án và đã nhận được hợp đồng freelance đầu tiên trị giá 500 USD.",
    highlight: "Nhận job freelance 500 USD đầu tay"
  }
];
---

<section id="community" class="py-20 md:py-32 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black mb-4">
        👥 <span class="gradient-text">Cộng Đồng Builder Việt Nam</span>
      </h2>
      <p class="section-subtitle">
        Bạn không hề đơn độc. Hàng nghìn anh chị em từ khắp mọi miền và nhiều ngành nghề đang cùng nhau học tập, chia sẻ và kiến tạo mỗi ngày.
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      {testimonials.map((t) => (
        <div class="glass p-8 rounded-3xl border border-dark-800 flex flex-col justify-between hover:border-accent-500/40 hover:-translate-y-1 transition-all duration-300">
          <div>
            <div class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-accent-500/10 text-accent-400 border border-accent-500/20 mb-4">
              ✨ {t.highlight}
            </div>
            <p class="text-dark-300 text-sm sm:text-base leading-relaxed italic mb-6">
              "{t.quote}"
            </p>
          </div>
          <div class="flex items-center space-x-3 pt-4 border-t border-dark-800/80">
            <div class="w-11 h-11 rounded-full bg-gradient-to-tr from-primary-500 to-accent-500 flex items-center justify-center text-xl shadow-md">
              {t.avatar}
            </div>
            <div>
              <div class="font-bold text-dark-100 text-sm">{t.name}</div>
              <div class="text-xs text-dark-400">{t.role}</div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Community Hub Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-4xl mx-auto">
      <a 
        href="https://www.youtube.com/@thanhnhan8650" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="glass p-6 rounded-2xl border border-dark-800 hover:border-red-500/50 hover:bg-dark-900/80 text-center transition-all group"
      >
        <div class="w-12 h-12 rounded-xl bg-red-500/10 text-red-500 mx-auto flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </div>
        <h4 class="font-bold text-dark-100 mb-1">Kênh YouTube</h4>
        <p class="text-xs text-dark-400">Xem video bài giảng & phân tích cập nhật mới nhất</p>
      </a>

      <a 
        href="#" 
        class="glass p-6 rounded-2xl border border-dark-800 hover:border-blue-500/50 hover:bg-dark-900/80 text-center transition-all group"
      >
        <div class="w-12 h-12 rounded-xl bg-blue-500/10 text-blue-400 mx-auto flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </div>
        <h4 class="font-bold text-dark-100 mb-1">Group Facebook</h4>
        <p class="text-xs text-dark-400">Giao lưu, hỏi đáp và chia sẻ ứng dụng bạn đã build</p>
      </a>

      <a 
        href="#" 
        class="glass p-6 rounded-2xl border border-dark-800 hover:border-indigo-500/50 hover:bg-dark-900/80 text-center transition-all group"
      >
        <div class="w-12 h-12 rounded-xl bg-indigo-500/10 text-indigo-400 mx-auto flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
        </div>
        <h4 class="font-bold text-dark-100 mb-1">Kênh Discord</h4>
        <p class="text-xs text-dark-400">Voice chat, sửa lỗi trực tiếp cùng mentor và các bạn</p>
      </a>
    </div>
  </div>
</section>
