    tagColor: "bg-purple-500/10 text-purple-400 border-purple-500/30",
    url: "https://www.youtube.com/@thanhnhan8650"
  },
  {
    id: "4",
    title: "Tạo Bot Tự Động Hóa Workflow Với n8n & Gemini AI",
    category: "AI Agent",
    duration: "28:50",
    views: "2.7K",
    date: "3 tuần trước",
    desc: "Kết nối Google Sheets, Telegram và AI để tạo luồng tự động hóa chăm sóc khách hàng 24/7.",
    tagColor: "bg-purple-500/10 text-purple-400 border-purple-500/30",
    url: "https://www.youtube.com/@thanhnhan8650"
  },
  {
    id: "5",
