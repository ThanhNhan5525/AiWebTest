---

<section id="videos" class="py-20 md:py-32 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black mb-4">
        🎬 <span class="gradient-text">Video Bài Giảng Nổi Bật</span>
      </h2>
      <p class="section-subtitle">
        Xem và thực hành theo từng video. Hoàn toàn miễn phí, có tài liệu và prompt đính kèm.
      </p>

      <!-- Category Filter Tabs -->
      <div class="flex flex-wrap items-center justify-center gap-2 mt-8" id="video-filter-tabs">
        <button class="filter-btn active px-5 py-2 rounded-xl text-sm font-semibold transition-all bg-gradient-to-r from-primary-500 to-accent-500 text-white shadow-md shadow-primary-500/20" data-filter="all">
          Tất cả
        </button>
        <button class="filter-btn px-5 py-2 rounded-xl text-sm font-semibold transition-all glass hover:bg-dark-800 text-dark-300 hover:text-white" data-filter="Vibe Coding">
          Vibe Coding
        </button>
        <button class="filter-btn px-5 py-2 rounded-xl text-sm font-semibold transition-all glass hover:bg-dark-800 text-dark-300 hover:text-white" data-filter="AI Agent">
          AI Agent
        </button>
        <button class="filter-btn px-5 py-2 rounded-xl text-sm font-semibold transition-all glass hover:bg-dark-800 text-dark-300 hover:text-white" data-filter="Tools">
          Tools & Tips
        </button>
      </div>
    </div>

    <!-- Video Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="video-grid">
      {videos.map((vid) => (
        <a 
          href={vid.url} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="video-card group block glass rounded-2xl overflow-hidden border border-dark-800 hover:border-primary-500/40 hover:-translate-y-1.5 transition-all duration-300"
          data-category={vid.category}
        >
          <!-- Video Thumbnail Container -->
          <div class="relative aspect-video bg-dark-900 overflow-hidden flex items-center justify-center">
            <!-- Simulated background gradient art -->
            <div class="absolute inset-0 bg-gradient-to-br from-dark-800 via-dark-900 to-dark-950 group-hover:scale-105 transition-transform duration-500"></div>
            
            <!-- Tech grid inside thumb -->
            <div class="absolute inset-0 opacity-20 bg-[linear-gradient(to_right,#38bdf820_1px,transparent_1px),linear-gradient(to_bottom,#38bdf820_1px,transparent_1px)] bg-[size:1.5rem_1.5rem]"></div>
            
            <!-- Category Badge -->
            <div class="absolute top-3 left-3 z-10">
              <span class={`text-[11px] font-bold px-3 py-1 rounded-full border backdrop-blur-md ${vid.tagColor}`}>
                {vid.category}
              </span>
            </div>

            <!-- Duration Badge -->
            <div class="absolute bottom-3 right-3 z-10 bg-dark-950/80 backdrop-blur-md px-2.5 py-1 rounded-md text-[11px] font-mono font-medium text-dark-200">
              {vid.duration}
            </div>

            <!-- Play Button Overlay -->
            <div class="relative z-10 w-14 h-14 rounded-full bg-red-600/90 group-hover:bg-red-500 group-hover:scale-110 flex items-center justify-center text-white shadow-xl shadow-red-600/40 transition-all duration-300">
              <svg class="w-6 h-6 fill-current translate-x-0.5" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z" />
              </svg>
            </div>
          </div>

          <!-- Video Info -->
          <div class="p-6">
            <h3 class="text-base font-bold text-dark-100 group-hover:text-primary-400 line-clamp-2 leading-snug mb-2 transition-colors">
              {vid.title}
            </h3>
            <p class="text-xs text-dark-400 line-clamp-2 mb-4 leading-relaxed">
              {vid.desc}
            </p>
            <div class="flex items-center justify-between text-[11px] text-dark-500 border-t border-dark-800/80 pt-3">
              <span class="flex items-center space-x-1">
                <span>👁️</span>
                <span>{vid.views}</span>
              </span>
              <span>{vid.date}</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="text-center mt-12">
      <a 
        href="https://www.youtube.com/@thanhnhan8650" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center space-x-3 px-8 py-4 glass glass-hover rounded-xl font-semibold text-sm text-dark-200 border border-dark-700 hover:border-red-500/40"
      >
        <span class="text-red-500 text-lg">▶</span>
        <span>Xem toàn bộ danh sách phát trên YouTube</span>
        <span>→</span>
      </a>
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.video-card');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      // update active button styles
      buttons.forEach((b) => {
        b.classList.remove('active', 'bg-gradient-to-r', 'from-primary-500', 'to-accent-500', 'text-white', 'shadow-md', 'shadow-primary-500/20');
        b.classList.add('glass', 'text-dark-300');
      });
      btn.classList.add('active', 'bg-gradient-to-r', 'from-primary-500', 'to-accent-500', 'text-white', 'shadow-md', 'shadow-primary-500/20');
      btn.classList.remove('glass', 'text-dark-300');

      const filter = btn.getAttribute('data-filter');

      cards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          (card as HTMLElement).style.display = 'block';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
